model UserCredential {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type CredentialType

  passwordHash       String?   @map("password_hash") @db.Text
  passwordAlgo       String?   @default("argon2id") @map("password_algo") @db.VarChar(32)
  passwordUpdatedAt  DateTime? @map("password_updated_at") @db.Timestamptz
  passwordExpiresAt  DateTime? @map("password_expires_at") @db.Timestamptz
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordHistory    Json      @default("[]") @map("password_history")

  webauthnCredentialId String?  @unique @map("webauthn_credential_id")
  webauthnPublicKey    Bytes?   @map("webauthn_public_key")
  webauthnCounter      BigInt?  @map("webauthn_counter")
  webauthnTransports   String[] @default([]) @map("webauthn_transports")
  webauthnAaguid       String?  @map("webauthn_aaguid") @db.VarChar(36)
  nickname             String?  @db.VarChar(100)

  isPrimary Boolean @default(false) @map("is_primary")
  isActive  Boolean @default(true) @map("is_active")

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@index([userId, type, isActive])
  @@map("user_credentials")
  @@schema("iam")
}
