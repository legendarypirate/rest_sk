NODE_ENV=development
APP_TIMEZONE=Asia/Ulaanbaatar
PORT=4004
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:3001,http://127.0.0.1:3001,kiosk://app

DATABASE_URL=postgresql://postgres:password@localhost:5432/db
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=restaurant
JWT_AUDIENCE=restaurant-web
AUTH_COOKIE_SECURE=false

SEED_ADMIN_EMAIL=admin@restaurant.local
SEED_ADMIN_PASSWORD=admin123!

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=restaurant

WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=20000
WS_CONNECT_TIMEOUT=45000
WS_MAX_HTTP_BUFFER_SIZE=1000000
WS_PING_RATE_LIMIT=30
WS_PING_RATE_WINDOW_MS=60000
