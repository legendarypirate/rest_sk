{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "electron"],
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["./**/*.cts", "./types/**/*.ts"]
}
