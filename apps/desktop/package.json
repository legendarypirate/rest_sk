{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Khongor self-service kiosk",
  "author": "Ikhtamir",
  "scripts": {
    "dev:next": "next dev -H 127.0.0.1 -p 3002 --webpack",
    "dev:electron": "tsc -p electron/tsconfig.json && electron ./electron/dist/main.cjs --renderer-url=http://127.0.0.1:3002/",
    "dev": "concurrently -k \"pnpm dev:next\" \"pnpm wait-and-electron\"",
    "wait-and-electron": "wait-on http://127.0.0.1:3002/ && pnpm dev:electron",
    "build:next": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "pnpm build:next && pnpm build:electron",
    "exe": "pnpm build && electron-builder --win nsis",
    "start": "electron ./electron/dist/main.cjs",
    "lint": "eslint"
  },
  "devDependencies": {
    "@packages/auth": "workspace:*",
    "@packages/i18n": "workspace:*",
    "@packages/types": "workspace:*",
    "@packages/ui": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.103.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
