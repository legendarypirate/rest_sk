# Browser + Socket.IO origin (baked into `next build`). Public HTTPS API.
NEXT_PUBLIC_API_URL=http://localhost:4004
NEXT_PUBLIC_WS_URL=http://localhost:4004

# Next.js rewrite target (server-side only). On Ubuntu use loopback.
API_INTERNAL_URL=http://localhost:4004

# Admin "Киоск татах" button. Nginx should serve this file.
# File must live at apps/admin/public/downloads/Khongor-Kiosk-Setup.exe
NEXT_PUBLIC_KIOSK_DOWNLOAD_URL=/downloads/Khongor-Kiosk-Setup.exe
